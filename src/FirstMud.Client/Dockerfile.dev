# Dev image for the Vite React client — source is volume-mounted, vite's
# dev server provides HMR.
FROM node:22-alpine

WORKDIR /app

# Install deps into the image layer; docker-compose mounts the source tree
# over /app but preserves /app/node_modules via an anonymous volume.
COPY package.json package-lock.json* ./
RUN npm install

EXPOSE 5173

# --host makes Vite listen on 0.0.0.0 so the port mapping works from the
# Windows host browser.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
