{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://first-mud.local/schemas/playbook.schema.json",
  "title": "Playbook",
  "description": "A canonical balance-harness scenario. The creative agent runs these every cycle; divergences between the actual viability band and the expected band indicate balance drift.",
  "type": "object",
  "required": ["id", "displayName", "description", "holdouts", "axes", "rolls", "seed", "expectedViability", "toleranceBands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "holdouts": {
      "type": "object",
      "description": "Fixed loadout parameters not varied by axes. Supports: playerLevel (int), playerElement (string), companions (array of {layer,element,level,type}), imbueLevel (int), gearTier (int), monsterId (string), dangerLevel (int).",
      "additionalProperties": true
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": ["gearTier", "dangerLevel", "playerLevel", "imbueLevel", "companionCount", "companionLayer"]
          },
          "values": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
        }
      }
    },
    "rolls": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "seed": { "type": "integer" },
    "expectedViability": {
      "type": "object",
      "required": ["cells"],
      "additionalProperties": true,
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["expected"],
            "additionalProperties": true,
            "properties": {
              "expected": {
                "type": "string",
                "enum": ["trivial", "easy", "balanced", "hard", "punishing"]
              }
            }
          }
        }
      }
    },
    "toleranceBands": {
      "type": "object",
      "required": ["trivial", "easy", "balanced", "hard", "punishing"],
      "additionalProperties": false,
      "properties": {
        "trivial":   { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "easy":      { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "balanced":  { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "hard":      { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "punishing": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      }
    }
  }
}
