{
  "$schema": "../schemas/playbook.schema.json",
  "id": "gear-only",
  "displayName": "Gear-only viability",
  "description": "Player + tier-N gear, no companions, no imbues. When does gear alone carry? DESIGN INTENT (CP7 follow-up Fix #2): gear tier now applies DISTINCTLY from player level — +15% weapon BasePower per tier on Strike + mitigation proxy via +3 Agility per tier. Baseline pl=5 + gt=N stays low-HP-pool, so mid/high-danger monsters still win attrition wars even as gear dps climbs. Post-decoupling expectation: gt=1..5 at d=1-3 is trivial; d=5 walks from balanced→trivial as gear grows; d=7-9 stays hard/punishing without a party even at gt=5 (you need imbues or companions to close the gap). Sim runs 1v1 vs representative monster (timber-wolf / dire-bear / frost-giant by danger bucket).",
  "holdouts": {
    "playerLevel": 5,
    "playerElement": "Aether"
  },
  "axes": [
    { "name": "gearTier",    "values": [1, 2, 3, 4, 5] },
    { "name": "dangerLevel", "values": [1, 3, 5, 7, 9] }
  ],
  "rolls": 200,
  "seed": 42,
  "expectedViability": {
    "cells": [
      { "gearTier": 1, "dangerLevel": 1, "expected": "trivial" },
      { "gearTier": 1, "dangerLevel": 3, "expected": "trivial" },
      { "gearTier": 1, "dangerLevel": 5, "expected": "balanced" },
      { "gearTier": 1, "dangerLevel": 7, "expected": "punishing" },
      { "gearTier": 1, "dangerLevel": 9, "expected": "punishing" },

      { "gearTier": 2, "dangerLevel": 1, "expected": "trivial" },
      { "gearTier": 2, "dangerLevel": 3, "expected": "trivial" },
      { "gearTier": 2, "dangerLevel": 5, "expected": "easy" },
      { "gearTier": 2, "dangerLevel": 7, "expected": "punishing" },
      { "gearTier": 2, "dangerLevel": 9, "expected": "punishing" },

      { "gearTier": 3, "dangerLevel": 1, "expected": "trivial" },
      { "gearTier": 3, "dangerLevel": 3, "expected": "trivial" },
      { "gearTier": 3, "dangerLevel": 5, "expected": "trivial" },
      { "gearTier": 3, "dangerLevel": 7, "expected": "hard" },
      { "gearTier": 3, "dangerLevel": 9, "expected": "punishing" },

      { "gearTier": 4, "dangerLevel": 1, "expected": "trivial" },
      { "gearTier": 4, "dangerLevel": 3, "expected": "trivial" },
      { "gearTier": 4, "dangerLevel": 5, "expected": "trivial" },
      { "gearTier": 4, "dangerLevel": 7, "expected": "hard" },
      { "gearTier": 4, "dangerLevel": 9, "expected": "punishing" },

      { "gearTier": 5, "dangerLevel": 1, "expected": "trivial" },
      { "gearTier": 5, "dangerLevel": 3, "expected": "trivial" },
      { "gearTier": 5, "dangerLevel": 5, "expected": "trivial" },
      { "gearTier": 5, "dangerLevel": 7, "expected": "balanced" },
      { "gearTier": 5, "dangerLevel": 9, "expected": "punishing" }
    ]
  },
  "toleranceBands": {
    "trivial":   [95, 100],
    "easy":      [85, 95],
    "balanced":  [60, 85],
    "hard":      [30, 60],
    "punishing": [0, 30]
  }
}
