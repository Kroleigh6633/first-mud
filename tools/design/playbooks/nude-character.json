{
  "$schema": "../schemas/playbook.schema.json",
  "id": "nude-character",
  "displayName": "Nude character viability",
  "description": "Player only (no companions, no imbues, no gear proxy). Where does a bare character alone stop working? Expectation: viable at low danger, falls off fast above danger 3.",
  "holdouts": {
    "playerLevel": 5,
    "playerElement": "Aether"
  },
  "axes": [
    { "name": "playerLevel", "values": [1, 3, 5, 8, 12] },
    { "name": "dangerLevel", "values": [0, 2, 4, 6, 8] }
  ],
  "rolls": 200,
  "seed": 42,
  "expectedViability": {
    "cells": [
      { "playerLevel": 1,  "dangerLevel": 0, "expected": "balanced" },
      { "playerLevel": 1,  "dangerLevel": 2, "expected": "hard" },
      { "playerLevel": 1,  "dangerLevel": 4, "expected": "punishing" },
      { "playerLevel": 1,  "dangerLevel": 6, "expected": "punishing" },
      { "playerLevel": 1,  "dangerLevel": 8, "expected": "punishing" },

      { "playerLevel": 3,  "dangerLevel": 0, "expected": "easy" },
      { "playerLevel": 3,  "dangerLevel": 2, "expected": "balanced" },
      { "playerLevel": 3,  "dangerLevel": 4, "expected": "hard" },
      { "playerLevel": 3,  "dangerLevel": 6, "expected": "punishing" },
      { "playerLevel": 3,  "dangerLevel": 8, "expected": "punishing" },

      { "playerLevel": 5,  "dangerLevel": 0, "expected": "trivial" },
      { "playerLevel": 5,  "dangerLevel": 2, "expected": "easy" },
      { "playerLevel": 5,  "dangerLevel": 4, "expected": "balanced" },
      { "playerLevel": 5,  "dangerLevel": 6, "expected": "hard" },
      { "playerLevel": 5,  "dangerLevel": 8, "expected": "punishing" },

      { "playerLevel": 8,  "dangerLevel": 0, "expected": "trivial" },
      { "playerLevel": 8,  "dangerLevel": 2, "expected": "trivial" },
      { "playerLevel": 8,  "dangerLevel": 4, "expected": "easy" },
      { "playerLevel": 8,  "dangerLevel": 6, "expected": "balanced" },
      { "playerLevel": 8,  "dangerLevel": 8, "expected": "hard" },

      { "playerLevel": 12, "dangerLevel": 0, "expected": "trivial" },
      { "playerLevel": 12, "dangerLevel": 2, "expected": "trivial" },
      { "playerLevel": 12, "dangerLevel": 4, "expected": "easy" },
      { "playerLevel": 12, "dangerLevel": 6, "expected": "balanced" },
      { "playerLevel": 12, "dangerLevel": 8, "expected": "balanced" }
    ]
  },
  "toleranceBands": {
    "trivial":   [95, 100],
    "easy":      [85, 95],
    "balanced":  [60, 85],
    "hard":      [30, 60],
    "punishing": [0, 30]
  }
}
