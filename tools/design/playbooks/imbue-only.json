{
  "$schema": "../schemas/playbook.schema.json",
  "id": "imbue-only",
  "displayName": "Imbue-only contribution",
  "description": "Baseline gear tier 3, no companions, varying imbue level. DESIGN INTENT (CP7 Fix #2): imbues now apply DISTINCTLY from level — +20% magical ability BasePower per imbue level + flat +4 per imbue to every ability base. Because the auto-sim player prefers Strike (physical, weave-cost 0), imbue contribution is weaker than gear in this config but still shows a clean upward trend. Expected: low danger (d<=5) trivial regardless of imbue; d=7 moves hard→balanced as imbue climbs; d=9 stays punishing until multiple imbue levels stack. A pure magic-caster playbook (if added) would show a steeper imbue curve.",
  "holdouts": {
    "playerLevel": 5,
    "playerElement": "Aether",
    "gearTier": 3
  },
  "axes": [
    { "name": "imbueLevel",  "values": [0, 1, 2, 3, 4] },
    { "name": "dangerLevel", "values": [3, 5, 7, 9] }
  ],
  "rolls": 200,
  "seed": 42,
  "expectedViability": {
    "cells": [
      { "imbueLevel": 0, "dangerLevel": 3, "expected": "trivial" },
      { "imbueLevel": 0, "dangerLevel": 5, "expected": "trivial" },
      { "imbueLevel": 0, "dangerLevel": 7, "expected": "hard" },
      { "imbueLevel": 0, "dangerLevel": 9, "expected": "punishing" },

      { "imbueLevel": 1, "dangerLevel": 3, "expected": "trivial" },
      { "imbueLevel": 1, "dangerLevel": 5, "expected": "trivial" },
      { "imbueLevel": 1, "dangerLevel": 7, "expected": "hard" },
      { "imbueLevel": 1, "dangerLevel": 9, "expected": "punishing" },

      { "imbueLevel": 2, "dangerLevel": 3, "expected": "trivial" },
      { "imbueLevel": 2, "dangerLevel": 5, "expected": "trivial" },
      { "imbueLevel": 2, "dangerLevel": 7, "expected": "hard" },
      { "imbueLevel": 2, "dangerLevel": 9, "expected": "punishing" },

      { "imbueLevel": 3, "dangerLevel": 3, "expected": "trivial" },
      { "imbueLevel": 3, "dangerLevel": 5, "expected": "trivial" },
      { "imbueLevel": 3, "dangerLevel": 7, "expected": "hard" },
      { "imbueLevel": 3, "dangerLevel": 9, "expected": "punishing" },

      { "imbueLevel": 4, "dangerLevel": 3, "expected": "trivial" },
      { "imbueLevel": 4, "dangerLevel": 5, "expected": "trivial" },
      { "imbueLevel": 4, "dangerLevel": 7, "expected": "hard" },
      { "imbueLevel": 4, "dangerLevel": 9, "expected": "punishing" }
    ]
  },
  "toleranceBands": {
    "trivial":   [95, 100],
    "easy":      [85, 95],
    "balanced":  [60, 85],
    "hard":      [30, 60],
    "punishing": [0, 30]
  }
}
