{
  "$schema": "../schemas/playbook.schema.json",
  "id": "auto-quest-completion",
  "kind": "flow",
  "displayName": "Auto-quest completion stress test",
  "description": "Flow playbook that stress-tests the auto-quest runner (L key) by simulating the client loop (accept → navigate → interact → complete) against every quest in content/quests.json, per starting zone. Outcomes: completed | stalled-no-start-zone | stalled-no-monsters | stalled-no-item-source | stalled-unknown-item | timeout. This is DATA triage — it flags quests whose content graph is incomplete. Runtime engine/handler bugs (e.g. the client loop waits forever for a server event that never fires) are NOT detected here and need live repros.",
  "holdouts": {
    "playerLevel": 5,
    "gearTier": 3,
    "companionCount": 3,
    "companionLayer": 2
  },
  "axes": [
    { "name": "startZoneId", "values": [
      "aeldran-1-caervorn-highlands",
      "aeldran-2-thornwood",
      "aeldran-5-drowned-coast",
      "aeldran-7-starting-road",
      "aeldran-8-gravenhold"
    ] },
    { "name": "questPoolSize", "values": [1, 3, 10] }
  ],
  "rolls": 1,
  "seed": 42,
  "simulatedMinutes": 30,
  "toleranceBands": {
    "healthy": [95, 100],
    "rough":   [70, 95],
    "broken":  [30, 70],
    "blocked": [0, 30]
  },
  "expectedMetrics": {
    "cells": [
      { "startZoneId": "aeldran-1-caervorn-highlands", "questPoolSize": 3, "label": "healthy", "completionRate": [80, 100], "stallRate": [0, 20] },
      { "startZoneId": "aeldran-2-thornwood",          "questPoolSize": 3, "label": "healthy", "completionRate": [80, 100], "stallRate": [0, 20] },
      { "startZoneId": "aeldran-5-drowned-coast",      "questPoolSize": 3, "label": "healthy", "completionRate": [80, 100], "stallRate": [0, 20] },
      { "startZoneId": "aeldran-7-starting-road",      "questPoolSize": 3, "label": "healthy", "completionRate": [80, 100], "stallRate": [0, 20] },
      { "startZoneId": "aeldran-8-gravenhold",         "questPoolSize": 3, "label": "healthy", "completionRate": [80, 100], "stallRate": [0, 20] }
    ]
  }
}
