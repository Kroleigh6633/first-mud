{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zones",
  "description": "Data-driven zone/biome definitions for first-mud. Loaded by ContentProvider at startup; drives seeder, BiomeService, and ZoneGridLayout.",
  "type": "object",
  "required": ["zones"],
  "properties": {
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "zoneId", "world", "zoneNumber", "name", "description",
          "asciiSymbol", "biome", "dangerLevel", "layout"
        ],
        "properties": {
          "zoneId": { "type": "string", "minLength": 1 },
          "world": {
            "type": "string",
            "enum": ["Aeldran", "ArdweldRemnant", "FairgeanDeep", "GolvariDeeps", "WyrdPaths", "TheDream"]
          },
          "zoneNumber": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "asciiSymbol": { "type": "string", "minLength": 1, "maxLength": 1 },
          "biome": {
            "type": "string",
            "enum": ["mountain", "forest", "plains", "swamp", "water", "desert", "wyrd", "sand", "path", "grassland", "denseForest", "snowMountain"]
          },
          "dangerLevel": { "type": "integer", "minimum": 1, "maximum": 10 },
          "isPortalZone": { "type": "boolean" },
          "portalDestination": {
            "type": ["string", "null"],
            "enum": ["Aeldran", "ArdweldRemnant", "FairgeanDeep", "GolvariDeeps", "WyrdPaths", "TheDream", null]
          },
          "isStartingZone": { "type": "boolean" },
          "layout": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 }
            }
          },
          "primaryResource": { "type": ["string", "null"] },
          "secondaryResource": { "type": ["string", "null"] },
          "monsterSpawns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["monsterId"],
              "properties": {
                "monsterId": { "type": "string", "minLength": 1 },
                "weight": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
