{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monsters",
  "description": "Data-driven monster and combat-ability definitions for first-mud. Loaded at startup by ContentProvider. Pack building, stat scaling, and boss logic remain in C# (MonsterFactory).",
  "type": "object",
  "required": ["abilities", "monsters"],
  "properties": {
    "abilities": {
      "type": "array",
      "description": "Shared combat-ability library referenced by monsters.",
      "items": {
        "type": "object",
        "required": ["id", "name", "basePower", "weaveCost", "element", "targetType", "category"],
        "properties": {
          "id": { "type": "string", "description": "Stable kebab-case identifier." },
          "name": { "type": "string", "description": "Display name shown in combat log." },
          "basePower": { "type": "integer", "minimum": 0 },
          "weaveCost": { "type": "integer", "minimum": 0 },
          "element": { "type": "string", "enum": ["Fire", "Water", "Earth", "Air", "Aether"] },
          "targetType": { "type": "string", "enum": ["Self", "SingleEnemy", "AllEnemies", "SingleAlly", "AllAllies"] },
          "category": { "type": "string", "enum": ["Attack", "Heal", "Buff", "Debuff", "Lifesteal", "Revive"] },
          "lifestealPower": { "type": "number", "minimum": 0 },
          "wyrdProcChance": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "monsters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "biome", "tier", "hp", "speed", "level", "element", "abilities"],
        "properties": {
          "id": { "type": "string", "description": "Stable kebab-case identifier." },
          "name": { "type": "string", "description": "Display name." },
          "biome": {
            "type": "string",
            "enum": ["mountain", "forest", "desert", "water", "swamp", "plains", "wyrd"]
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Danger tier: 0 = danger 1-2, 1 = 3-4, 2 = 5-7, 3 = 8+."
          },
          "hp": { "type": "integer", "minimum": 0 },
          "speed": { "type": "integer", "minimum": 0 },
          "level": { "type": "integer", "minimum": 1 },
          "element": { "type": "string", "enum": ["Fire", "Water", "Earth", "Air", "Aether"] },
          "abilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "description": "Reference to an ability id." }
          }
        }
      }
    }
  }
}
