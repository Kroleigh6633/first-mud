{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zone Rumors",
  "description": "Ambient rumor strings surfaced for unexplored zones. 3-5 per zone. Text-only — no mechanical effects.",
  "type": "object",
  "required": ["zones"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["zoneId", "rumors"],
        "additionalProperties": false,
        "properties": {
          "zoneId": { "type": "string", "minLength": 1 },
          "rumors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
